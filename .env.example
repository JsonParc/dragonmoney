# Copy to .env and fill in. Never commit .env.
STOCKBOT_WEB_PASSWORD=
STOCKBOT_PIN=
STOCKBOT_SECRET_KEY=
STOCKBOT_DB_URL=sqlite:///data/stockbot.db
# SLBM 위키 밸런스 봇과 같은 토큰을 써도 됩니다 (BALANCE_TELEGRAM_BOT_TOKEN 값).
STOCKBOT_TELEGRAM_TOKEN=
# 내 개인 채팅 ID만 넣으세요 (클랜 채널 ID -100... 넣지 말 것). 봇에게 /id 를 보내면 알려줍니다.
# JSON list, e.g. [123456789]
STOCKBOT_TELEGRAM_CHAT_IDS=[]
STOCKBOT_FINNHUB_KEY=
STOCKBOT_GEMINI_KEY=
STOCKBOT_GROQ_KEY=
STOCKBOT_OPENAI_KEY=
STOCKBOT_ANTHROPIC_KEY=
# Optional model id overrides (defaults in src/stockbot/llm/pricing.py)
STOCKBOT_GEMINI_MODEL=
STOCKBOT_GEMINI_LITE_MODEL=
STOCKBOT_GROQ_MODEL=
STOCKBOT_GROQ_ALT_MODEL=
STOCKBOT_GROQ_VISION_MODEL=
STOCKBOT_OPENAI_MODEL=
STOCKBOT_ANTHROPIC_MODEL=
